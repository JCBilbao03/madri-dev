# Firebase web config (optional — defaults are baked in for madridev-119f7)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Required for production contact-form and cleaning-booking lead writes (Firebase App Check + reCAPTCHA Enterprise)
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Local dev only: fixed App Check debug token (register once in Firebase Console → App Check → Manage debug tokens)
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=

# Admin email (hello@madribuild.com) — DO NOT put Titan credentials in Vite env.
# Store server-side only via Firebase Functions secrets:
#   firebase functions:secrets:set TITAN_EMAIL
#   firebase functions:secrets:set TITAN_APP_PASSWORD
