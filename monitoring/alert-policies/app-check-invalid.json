{
  "displayName": "MadriBuild — App Check invalid verdicts",
  "documentation": {
    "content": "App Check is rejecting client tokens at an elevated rate for 5 minutes. This may indicate bot traffic, a misconfigured site key, or missing debug tokens on localhost.\n\nCheck Firebase Console → App Check → Metrics.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "App Check DENY rate above threshold",
      "conditionThreshold": {
        "filter": "resource.type = \"firebaseappcheck.googleapis.com/Instance\" AND metric.type = \"firebaseappcheck.googleapis.com/services/verdict_count\" AND metric.labels.result = \"DENY\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 20,
        "duration": "300s",
        "trigger": {
          "count": 1
        },
        "evaluationMissingData": "EVALUATION_MISSING_DATA_INACTIVE"
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "604800s"
  }
}
