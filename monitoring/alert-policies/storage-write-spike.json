{
  "displayName": "MadriBuild — Storage write spike",
  "documentation": {
    "content": "Cloud Storage write requests exceeded the expected rate for 5 minutes. This may indicate inventory photo upload abuse.\n\nCheck Firebase Console → Storage → Usage and App Check enforcement.",
    "mimeType": "text/markdown"
  },
  "combiner": "OR",
  "enabled": true,
  "conditions": [
    {
      "displayName": "Storage API write rate above threshold",
      "conditionThreshold": {
        "filter": "resource.type = \"gcs_bucket\" AND metric.type = \"storage.googleapis.com/api/request_count\" AND metric.labels.method = \"WriteObject\"",
        "aggregations": [
          {
            "alignmentPeriod": "300s",
            "perSeriesAligner": "ALIGN_RATE"
          }
        ],
        "comparison": "COMPARISON_GT",
        "thresholdValue": 30,
        "duration": "300s",
        "trigger": {
          "count": 1
        },
        "evaluationMissingData": "EVALUATION_MISSING_DATA_INACTIVE"
      }
    }
  ],
  "alertStrategy": {
    "autoClose": "604800s"
  }
}
